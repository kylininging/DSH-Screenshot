{
  "name": "@local/dsh-screenshot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QQ-style screenshot button for the DSH composer: region drag or full desktop, each with or without the Harness window, pasted straight into the draft.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "screenshot",
    "screen-capture"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "capture.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
